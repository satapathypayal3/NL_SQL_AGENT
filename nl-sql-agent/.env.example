# Copy this file to .env and fill in ONE key.

# Groq (default, free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier): https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# OpenAI (paid)
# OPENAI_API_KEY=

# Model to use, as provider:model-name
MODEL=groq:openai/gpt-oss-120b
# MODEL=google_genai:gemini-2.5-flash
# MODEL=openai:gpt-4o-mini
